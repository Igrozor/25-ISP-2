def calculate_deposit(start_money, percent, target_money):
    months=0
    if (percent<=0 or target_money <= start_money):
        print("Это предупреждение.")
        return 0
    while start_money < target_money:
        start_money = start_money + start_money * (percent / 100)  
        months+=1
    return months
print(calculate_deposit(100, 20, 200))

