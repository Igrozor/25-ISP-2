def even_stats(limit):
    end = limit
    start = 1
    sum = 0
    amount = 0
    
    if end < 2:
        print("Четных чисел нет")
        return 0 
        
    while start < end:
        if start % 2 == 0:
            amount += 1
            sum += start
        start += 1  
        
    return (sum/amount)

print(even_stats(5))

