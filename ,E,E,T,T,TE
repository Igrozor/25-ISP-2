def guess_number(secret, max_attempts):
    attempts = max_attempts
    
    while attempts > 0:
        number = int(input("Введите число: "))
        attempts -=1
        if number == secret:
            print("Победа! Вы угадали число!")
            return
        elif number > secret:
            print("Меньше!")
        else:
            print("Больше!")
    print(f"Попытки закончились! Было загадано: {secret}")
guess_number(5, 5)

